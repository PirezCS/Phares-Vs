#include <stdio.h>

#define MAX 10

int main(void) {
    int matrix[MAX][MAX];
    int sparse[MAX * MAX][3];
    int rows, cols, i, j, count = 0;

    printf("Enter rows and columns: ");
    scanf("%d %d", &rows, &cols);

    if (rows <= 0 || cols <= 0 || rows > MAX || cols > MAX) {
        printf("Size must be between 1 and %d.\n", MAX);
        return 1;
    }

    printf("Enter the matrix:\n");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &matrix[i][j]);
            if (matrix[i][j] != 0) {
                count++;
                sparse[count][0] = i;
                sparse[count][1] = j;
                sparse[count][2] = matrix[i][j];
            }
        }
    }

    sparse[0][0] = rows;
    sparse[0][1] = cols;
    sparse[0][2] = count;

    printf("\nRow\tCol\tValue\n");
    for (i = 0; i <= count; i++)
        printf("%d\t%d\t%d\n", sparse[i][0], sparse[i][1], sparse[i][2]);

    return 0;
}